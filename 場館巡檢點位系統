    // IndexedDB setup for HD Map Blob Storage
    function initIndexedDB() {
      return new Promise((resolve, reject) => {
        const request = indexedDB.open('VenueInspectionDB', 1);
        request.onupgradeneeded = (e) => {
          const idb = e.target.result;
          if (!idb.objectStoreNames.contains('mapBlobs')) {
            idb.createObjectStore('mapBlobs', { keyPath: 'id' });
          }
        };
        request.onsuccess = (e) => {
          dbIndexedDB = e.target.result;
          resolve(dbIndexedDB);
        };
        request.onerror = (e) => reject(e);
      });
    }

    function saveMapToIndexedDB(id, dataUrl) {
      return new Promise((resolve, reject) => {
        if (!dbIndexedDB) return resolve();
        const transaction = dbIndexedDB.transaction(['mapBlobs'], 'readwrite');
        const store = transaction.objectStore('mapBlobs');
        store.put({ id, dataUrl });
        transaction.oncomplete = () => resolve();
        transaction.onerror = (e) => reject(e);
      });
    }

    function getMapFromIndexedDB(id) {
      return new Promise((resolve) => {
        if (!dbIndexedDB) return resolve(null);
        const transaction = dbIndexedDB.transaction(['mapBlobs'], 'readonly');
        const store = transaction.objectStore('mapBlobs');
        const request = store.get(id);
        request.onsuccess = () => resolve(request.result ? request.result.dataUrl : null);
        request.onerror = () => resolve(null);
      });
    }

    function deleteMapFromIndexedDB(id) {
      return new Promise((resolve) => {
        if (!dbIndexedDB) return resolve();
        const transaction = dbIndexedDB.transaction(['mapBlobs'], 'readwrite');
        const store = transaction.objectStore('mapBlobs');
        store.delete(id);
        transaction.oncomplete = () => resolve();
      });
    }

