<!DOCTYPE html>
<html lang="zh-TW" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>場館點位管理與巡檢系統</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- Swiper.js CSS & JS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <!-- PDF.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script>
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  </script>
  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
    ::-webkit-scrollbar-thumb { background: rgba(51, 65, 85, 0.8); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(71, 85, 105, 1); }

    /* Pulse animation for pins */
    @keyframes pinPulseRing {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.4); opacity: 0; }
      100% { transform: scale(0.95); opacity: 0; }
    }
    .pin-pulse-ring {
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      border-radius: 50%;
      border: 2px solid #ef4444;
      animation: pinPulseRing 2s infinite ease-out;
      pointer-events: none;
    }

    /* Modal Backdrop Blur */
    .glass-modal {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(12px);
    }
  </style>
</head>
<body class="h-full flex flex-col font-sans overflow-hidden select-none bg-slate-950">

  <!-- Header Section -->
  <header class="h-16 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 px-4 flex items-center justify-between z-30 shrink-0">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-500 to-blue-600 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-sky-500/20">
        <i class="fa-solid fa-map-location-dot"></i>
      </div>
      <div>
        <h1 class="text-base font-bold text-slate-100 flex items-center gap-2">
          場館點位巡檢系統
          <span id="roleBadge" class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 font-medium">訪客 (VISITOR)</span>
        </h1>
        <p class="text-xs text-slate-400 hidden sm:block">室內平面標註 • 巡檢紀錄 • 多人雲端即時同步</p>
      </div>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-2">
      <!-- Share Link Button -->
      <button id="btnShareLink" class="px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold flex items-center gap-1.5 transition-all shadow-md shadow-indigo-600/20" title="複製連結分享給同事">
        <i class="fa-solid fa-share-nodes"></i> <span class="hidden md:inline">快速分享</span>
      </button>

      <!-- Add Pin Button (Admin Only) -->
      <button id="btnAddPinMode" class="hidden px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold flex items-center gap-1.5 transition-all shadow-md shadow-emerald-600/20">
        <i class="fa-solid fa-location-crosshairs"></i> <span class="hidden md:inline">新增點位模式</span>
      </button>

      <!-- Upload Map (Admin Only) -->
      <button id="btnUploadMap" class="hidden px-3 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold flex items-center gap-1.5 transition-all shadow-md shadow-sky-600/20">
        <i class="fa-solid fa-file-arrow-up"></i> <span class="hidden md:inline">上傳圖資</span>
      </button>

      <!-- Switch Role Button -->
      <button id="btnSwitchRole" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-semibold flex items-center gap-1.5 transition-all">
        <i class="fa-solid fa-user-shield"></i> <span>權限切換</span>
      </button>

      <!-- System Menu -->
      <button id="btnMenu" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 flex items-center justify-center transition-all">
        <i class="fa-solid fa-gear"></i>
      </button>
    </div>
  </header>

  <!-- Map Selector Bar -->
  <div class="bg-slate-900 border-b border-slate-800/80 px-4 py-2 flex items-center gap-2 z-20 shrink-0 overflow-x-auto">
    <span class="text-xs font-semibold text-slate-400 shrink-0 flex items-center gap-1"><i class="fa-solid fa-layer-group"></i> 地圖區域：</span>
    <div id="mapTabsContainer" class="flex items-center gap-2">
      <!-- Dynamic Map Tabs -->
    </div>
  </div>

  <!-- Main Workspace / Interactive Map Area -->
  <main class="flex-1 relative bg-slate-950 overflow-hidden cursor-grab active:cursor-grabbing" id="canvasViewport">
    
    <!-- Empty Map Hint -->
    <div id="emptyState" class="absolute inset-0 flex flex-col items-center justify-center z-10 text-slate-500 p-6 text-center">
      <i class="fa-solid fa-map-location text-6xl mb-4 text-slate-700"></i>
      <h3 class="text-lg font-bold text-slate-400 mb-1">尚未載入任何平面地圖</h3>
      <p class="text-xs text-slate-500 max-w-sm">請權限管理員點擊右上角「上傳圖資」按鈕，上傳場館平面圖（支援 JPG, PNG, PDF 格式）。</p>
    </div>

    <!-- Interactive Canvas & Map Canvas Wrapper -->
    <div id="mapWrapper" class="absolute origin-top-left hidden transition-transform duration-75 ease-out">
      <img id="mapImage" class="max-w-none pointer-events-none" alt="Map View" />
      <div id="pinsContainer" class="absolute inset-0 pointer-events-auto">
        <!-- Dynamic Pins Rendered Here -->
      </div>
    </div>

    <!-- Viewport Zoom / Pan Floating Toolbar -->
    <div class="absolute bottom-6 right-6 z-20 flex flex-col gap-2 bg-slate-900/90 border border-slate-800 backdrop-blur-md p-1.5 rounded-xl shadow-2xl">
      <button id="btnZoomIn" class="w-10 h-10 rounded-lg hover:bg-slate-800 flex items-center justify-center text-slate-200 text-sm transition-colors" title="放大">
        <i class="fa-solid fa-plus"></i>
      </button>
      <button id="btnZoomOut" class="w-10 h-10 rounded-lg hover:bg-slate-800 flex items-center justify-center text-slate-200 text-sm transition-colors" title="縮小">
        <i class="fa-solid fa-minus"></i>
      </button>
      <button id="btnResetZoom" class="w-10 h-10 rounded-lg hover:bg-slate-800 flex items-center justify-center text-slate-200 text-xs transition-colors font-bold" title="重設尺寸">
        100%
      </button>
    </div>
  </main>

  <!-- Modals Section -->

  <!-- 1. Role Switch Modal -->
  <div id="modalRole" class="fixed inset-0 z-50 glass-modal flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-md shadow-2xl relative">
      <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
        <h3 class="text-base font-bold text-slate-100 flex items-center gap-2"><i class="fa-solid fa-shield-halved text-sky-500"></i> 切換使用者權限</h3>
        <button class="btnCloseModal text-slate-400 hover:text-slate-200"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>

      <form id="formSwitchRole" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">選擇身份角色</label>
          <select id="roleSelect" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-sky-500">
            <option value="VISITOR">訪客 (VISITOR - 僅檢視)</option>
            <option value="ADMIN">巡檢管理員 (ADMIN)</option>
            <option value="SUPERADMIN">超級管理員 (SUPERADMIN)</option>
          </select>
        </div>

        <div id="passwordField" class="hidden">
          <label class="block text-xs font-semibold text-slate-400 mb-1">輸入驗證密碼</label>
          <input type="password" id="rolePassword" placeholder="管理員密碼" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-sky-500">
          <p class="text-[11px] text-slate-500 mt-1">預設巡檢管理員: admin / 超級管理員: superadmin</p>
        </div>

        <div class="flex justify-end gap-2 pt-2 border-t border-slate-800">
          <button type="button" class="btnCloseModal px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300">取消</button>
          <button type="submit" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-xs font-semibold text-white">確認切換</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 2. Upload Map Modal -->
  <div id="modalUpload" class="fixed inset-0 z-50 glass-modal flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-md shadow-2xl relative">
      <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
        <h3 class="text-base font-bold text-slate-100 flex items-center gap-2"><i class="fa-solid fa-cloud-arrow-up text-sky-500"></i> 上傳平面地圖</h3>
        <button class="btnCloseModal text-slate-400 hover:text-slate-200"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>

      <form id="formUploadMap" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">地圖/區域名稱 (例如：1F 展演廳)</label>
          <input type="text" id="inputMapName" required placeholder="請輸入樓層或區域區劃" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-sky-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">選擇圖資檔案 (JPG, PNG, PDF)</label>
          <input type="file" id="inputMapFile" accept="image/jpeg,image/png,application/pdf" required class="w-full text-xs text-slate-400 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-sky-600 file:text-white hover:file:bg-sky-500">
        </div>

        <div id="uploadProgress" class="hidden space-y-1">
          <div class="flex justify-between text-xs text-slate-400">
            <span>圖資轉碼與壓縮處理中...</span>
            <span id="uploadProgressText">0%</span>
          </div>
          <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden">
            <div id="uploadProgressBar" class="bg-sky-500 h-full w-0 transition-all duration-200"></div>
          </div>
        </div>

        <div class="flex justify-end gap-2 pt-2 border-t border-slate-800">
          <button type="button" class="btnCloseModal px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300">取消</button>
          <button type="submit" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-xs font-semibold text-white">上傳圖資</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 3. Add / Edit Pin Form Modal -->
  <div id="modalPinForm" class="fixed inset-0 z-50 glass-modal flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-lg shadow-2xl relative max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
        <h3 id="pinFormTitle" class="text-base font-bold text-slate-100 flex items-center gap-2"><i class="fa-solid fa-pen-to-square text-emerald-500"></i> 新增巡檢標註點位</h3>
        <button class="btnCloseModal text-slate-400 hover:text-slate-200"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>

      <form id="formPin" class="space-y-4">
        <input type="hidden" id="pinId">
        <input type="hidden" id="pinPosX">
        <input type="hidden" id="pinPosY">

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">標題 / 巡檢項目名稱 *</label>
          <input type="text" id="pinTitle" required placeholder="例如：消防栓水壓異常 / 逃生門無法關閉" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-sky-500">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">權責責任單位 *</label>
            <input type="text" id="pinDepartment" required placeholder="例如：營修組、機電工程科" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-sky-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">預計復原完成日期</label>
            <input type="date" id="pinDueDate" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-sky-500">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">處置方式 / 復原規劃說明</label>
          <textarea id="pinAction" rows="2" placeholder="詳細說明處置方式或備料修繕進度..." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-sky-500"></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">備註說明</label>
          <textarea id="pinNote" rows="2" placeholder="補充說明或其他注意事項..." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-sky-500"></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">現場照片 (支援多張自動壓縮上傳)</label>
          <input type="file" id="pinPhotos" accept="image/*" multiple class="w-full text-xs text-slate-400 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-slate-800 file:text-slate-300 hover:file:bg-slate-700">
          <div id="photoPreviewContainer" class="flex flex-wrap gap-2 mt-2"></div>
        </div>

        <div class="flex justify-end gap-2 pt-2 border-t border-slate-800">
          <button type="button" class="btnCloseModal px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300">取消</button>
          <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-xs font-semibold text-white">儲存點位</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 4. Pin Detail View Modal (Swiper Carousel) -->
  <div id="modalPinDetail" class="fixed inset-0 z-50 glass-modal flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-xl shadow-2xl relative max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
        <h3 id="detailTitle" class="text-base font-bold text-slate-100 flex items-center gap-2"></h3>
        <button class="btnCloseModal text-slate-400 hover:text-slate-200"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>

      <div class="space-y-4">
        <!-- Swiper Image Carousel Container -->
        <div id="swiperWrapperBox" class="w-full h-64 bg-slate-950 rounded-xl overflow-hidden relative border border-slate-800 hidden">
          <div class="swiper mySwiper w-full h-full">
            <div class="swiper-wrapper" id="detailSwiperSlides"></div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-pagination"></div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 text-xs bg-slate-950/60 p-3 rounded-xl border border-slate-800/60">
          <div>
            <span class="text-slate-500 block">權責責任單位：</span>
            <span id="detailDepartment" class="font-semibold text-slate-200"></span>
          </div>
          <div>
            <span class="text-slate-500 block">預計復原完成日：</span>
            <span id="detailDueDate" class="font-semibold text-slate-200"></span>
          </div>
        </div>

        <div class="text-xs space-y-1">
          <span class="text-slate-500 block">復原方式與處置說明：</span>
          <p id="detailAction" class="bg-slate-950/60 p-3 rounded-xl text-slate-300 border border-slate-800/60 leading-relaxed min-h-[4rem] whitespace-pre-line"></p>
        </div>

        <div class="text-xs space-y-1">
          <span class="text-slate-500 block">備註說明：</span>
          <p id="detailNote" class="bg-slate-950/60 p-3 rounded-xl text-slate-300 border border-slate-800/60 leading-relaxed min-h-[3rem] whitespace-pre-line"></p>
        </div>

        <div class="flex justify-between items-center pt-2 border-t border-slate-800">
          <div id="adminDetailControls" class="flex gap-2">
            <!-- Dynamic Edit / Delete Buttons -->
          </div>
          <button type="button" class="btnCloseModal px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300">關閉</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. System Config & Drive Sync Modal -->
  <div id="modalSystem" class="fixed inset-0 z-50 glass-modal flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-md shadow-2xl relative">
      <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
        <h3 class="text-base font-bold text-slate-100 flex items-center gap-2"><i class="fa-solid fa-sliders text-sky-500"></i> 系統與資料管理</h3>
        <button class="btnCloseModal text-slate-400 hover:text-slate-200"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>

      <div class="space-y-4 text-xs">
        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800 space-y-2">
          <h4 class="font-bold text-slate-300 flex items-center gap-1.5"><i class="fa-solid fa-database text-sky-400"></i> 巡檢點位資料備份與匯出</h4>
          <p class="text-slate-400">將場館內所有地圖結構與點位紀錄下載為 .json 備份檔。</p>
          <button id="btnExportJSON" class="w-full py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg font-semibold border border-slate-700 transition-colors flex items-center justify-center gap-2">
            <i class="fa-solid fa-download"></i> 匯出系統備份 (.json)
          </button>
        </div>

        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800 space-y-2">
          <h4 class="font-bold text-slate-300 flex items-center gap-1.5"><i class="fa-solid fa-cloud text-sky-400"></i> 雲端圖資硬碟指引</h4>
          <p class="text-slate-400">為保護瀏覽器載入效能，請確保原高解析度繪圖檔 (CAD/PDF) 於團隊共用雲端存放。</p>
          <a href="https://drive.google.com" target="_blank" class="block text-center py-2 bg-slate-800 hover:bg-slate-700 text-sky-400 rounded-lg font-semibold border border-slate-700 transition-colors">
            開啟團隊共用雲端硬碟 <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
          </a>
        </div>

        <div id="superAdminSystemSection" class="p-3 bg-rose-950/20 border border-rose-900/50 rounded-xl space-y-2 hidden">
          <h4 class="font-bold text-rose-400 flex items-center gap-1.5"><i class="fa-solid fa-triangle-exclamation"></i> 超級管理員控制區</h4>
          <p class="text-slate-400">刪除當前地圖將會一併移除該區域所有標註點位！</p>
          <button id="btnDeleteCurrentMap" class="w-full py-2 bg-rose-600 hover:bg-rose-500 text-white rounded-lg font-semibold transition-colors flex items-center justify-center gap-2">
            <i class="fa-solid fa-trash-can"></i> 刪除當前平面圖層
          </button>
        </div>

        <div class="flex justify-end pt-2 border-t border-slate-800">
          <button type="button" class="btnCloseModal px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300">關閉</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Message -->
  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-xl text-xs font-semibold shadow-2xl transition-all duration-300 opacity-0 pointer-events-none flex items-center gap-2"></div>

  <!-- JavaScript App Logic -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, doc, setDoc, deleteDoc, onSnapshot, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    // Global State
    let currentRole = 'VISITOR'; // VISITOR | ADMIN | SUPERADMIN
    let db = null;
    let auth = null;
    let dbIndexedDB = null;
    let maps = [];
    let pins = [];
