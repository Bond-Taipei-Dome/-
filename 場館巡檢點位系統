    // Setup All Event Listeners
    function setupEventListeners() {
      setupViewportControls();

      // Share Link Button Event (Fixed URL Resolution for Iframe/Sandbox)
      const shareBtn = document.getElementById('btnShareLink');
      if (shareBtn) {
        shareBtn.onclick = () => {
          let shareUrl = '';
          
          // 1. 嘗試獲取頂層最外層主視窗網址 (若跨網域 sandbox 會跳 catch)
          try {
            if (window.top && window.top.location && window.top.location.href) {
              shareUrl = window.top.location.href;
            }
          } catch (e) {
            // 跨網域存取失敗時靜態捕捉
          }

          // 2. 若無法獲取外層網址，讀取當前 window location
          if (!shareUrl || shareUrl.startsWith('about:') || shareUrl.startsWith('blob:')) {
            try {
              if (window.parent && window.parent !== window && window.parent.location && window.parent.location.href) {
                shareUrl = window.parent.location.href;
              }
            } catch(e) {}
          }

          // 3. Fallback 到當前視窗網址
          if (!shareUrl || shareUrl.startsWith('about:') || shareUrl.startsWith('blob:')) {
            shareUrl = window.location.href;
          }

          // 清除不必要的內部 blob: 或相對位址
          if (!shareUrl || shareUrl.startsWith('about:') || shareUrl.startsWith('blob:')) {
            shareUrl = window.location.origin !== 'null' ? window.location.origin + window.location.pathname : '';
          }

          // 若解析出的網址無效，彈出對話框讓使用者手動輸入/複製
          if (!shareUrl || shareUrl === 'about:blank') {
            const manualUrl = prompt('請複製以下系統網址分享給同事：', window.location.href);
            return;
          }

          // 執行剪貼簿寫入
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(shareUrl).then(() => {
              showToast('系統連結已成功複製！可直接發送給同事共同協作。', 'success');
            }).catch(() => {
              fallbackCopyTextToClipboard(shareUrl);
            });
          } else {
            fallbackCopyTextToClipboard(shareUrl);
          }
        };
      }

      function fallbackCopyTextToClipboard(text) {
        const textArea = document.createElement("textarea");
        textArea.value = text;
        textArea.style.position = "fixed";
        textArea.style.top = "0";
        textArea.style.left = "-9999px";
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
          const successful = document.execCommand('copy');
          if (successful) {
            showToast('系統連結已成功複製！可直接發送給同事共同協作。', 'success');
          } else {
            prompt('請複製以下連結：', text);
          }
        } catch (err) {
          prompt('請複製以下連結：', text);
        }
        document.body.removeChild(textArea);
      }

      // Close buttons for Modals
      document.querySelectorAll('.btnCloseModal').forEach(btn => {
        btn.onclick = () => {
          btn.closest('.glass-modal').classList.add('hidden');
        };
      });

      // Role Modal Trigger
      document.getElementById('btnSwitchRole').onclick = () => {
        document.getElementById('roleSelect').value = currentRole;
        togglePasswordInput();
        openModal('modalRole');
      };

      document.getElementById('roleSelect').onchange = togglePasswordInput;

      // Switch Role Submit Form
      document.getElementById('formSwitchRole').onsubmit = (e) => {
        e.preventDefault();
        const role = document.getElementById('roleSelect').value;
        const pwd = document.getElementById('rolePassword').value;

        if (role === 'ADMIN' && pwd !== 'admin') {
          showToast('巡檢管理員密碼錯誤！', 'error');
          return;
        }
        if (role === 'SUPERADMIN' && pwd !== 'superadmin') {
          showToast('超級管理員密碼錯誤！', 'error');
          return;
        }

        currentRole = role;
        updateRoleUI();
        closeModal('modalRole');
        showToast(`已成功切換為：${role}`, 'success');
      };

      // Add Pin Mode Toggle Button
      document.getElementById('btnAddPinMode').onclick = toggleAddPinMode;

      // Upload Map Modal Trigger
      document.getElementById('btnUploadMap').onclick = () => {
        document.getElementById('formUploadMap').reset();
        document.getElementById('uploadProgress').classList.add('hidden');
        openModal('modalUpload');
      };

      // Map File Processing (PDF / Images)
      document.getElementById('formUploadMap').onsubmit = async (e) => {
        e.preventDefault();
        const mapName = document.getElementById('inputMapName').value;
        const fileInput = document.getElementById('inputMapFile');
        const file = fileInput.files[0];

        if (!file) return;

        const progress = document.getElementById('uploadProgress');
        const bar = document.getElementById('uploadProgressBar');
        const text = document.getElementById('uploadProgressText');
        progress.classList.remove('hidden');

        bar.style.width = '20%'; text.textContent = '20%';

        const mapId = 'map_' + Date.now();
        let dataUrl = '';

        if (file.type === 'application/pdf') {
          bar.style.width = '40%'; text.textContent = '40% (解析 PDF 圖頁中)';
          const arrayBuffer = await file.arrayBuffer();
          const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
          const page = await pdf.getPage(1);
          const viewport = page.getViewport({ scale: 2.0 });

          const canvas = document.createElement('canvas');
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          const ctx = canvas.getContext('2d');
          await page.render({ canvasContext: ctx, viewport }).promise;
          dataUrl = canvas.toDataURL('image/jpeg', 0.92);
        } else {
          bar.style.width = '50%'; text.textContent = '50% (轉碼壓縮圖像中)';
          dataUrl = await new Promise(res => {
            const r = new FileReader();
            r.onload = ev => res(ev.target.result);
            r.readAsDataURL(file);
          });
        }

        bar.style.width = '80%'; text.textContent = '80% (寫入 IndexedDB 快取)';
        await saveMapToIndexedDB(mapId, dataUrl);

        const newMapObj = {
          id: mapId,
          name: mapName,
          createdAt: new Date().toISOString()
        };

        if (db) {
          await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'maps', mapId), newMapObj);
        } else {
          maps.push(newMapObj);
        }

        bar.style.width = '100%'; text.textContent = '100%';
        closeModal('modalUpload');
        selectMap(mapId);
        showToast(`地圖「${mapName}」上傳成功！`, 'success');
      };

      // Form Pin Submit
      document.getElementById('formPin').onsubmit = async (e) => {
        e.preventDefault();
        const id = document.getElementById('pinId').value || 'pin_' + Date.now();
        const pinObj = {
          id,
          mapId: currentMapId,
          x: parseFloat(document.getElementById('pinPosX').value),
          y: parseFloat(document.getElementById('pinPosY').value),
          title: document.getElementById('pinTitle').value,
          department: document.getElementById('pinDepartment').value,
          dueDate: document.getElementById('pinDueDate').value,
          action: document.getElementById('pinAction').value,
          note: document.getElementById('pinNote').value,
          photos: pinPhotosBase64,
          updatedAt: new Date().toISOString()
        };

        if (db) {
          await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'pins', id), pinObj);
        } else {
          const idx = pins.findIndex(p => p.id === id);
          if (idx >= 0) pins[idx] = pinObj;
          else pins.push(pinObj);
          renderPins();
        }

        closeModal('modalPinForm');
        disableAddPinMode();
        showToast('巡檢標註點位已儲存', 'success');
      };

      // System Menu Trigger
      document.getElementById('btnMenu').onclick = () => {
        openModal('modalSystem');
      };

      // Export JSON Backup
      document.getElementById('btnExportJSON').onclick = () => {
        const backupData = { maps, pins, exportedAt: new Date().toISOString() };
        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backupData, null, 2));
        const dlAnchor = document.createElement('a');
        dlAnchor.setAttribute("href", dataStr);
        dlAnchor.setAttribute("download", `Venue_Inspection_Backup_${Date.now()}.json`);
        document.body.appendChild(dlAnchor);
        dlAnchor.click();
        dlAnchor.remove();
        showToast('系統資料 JSON 備份檔已開始下載', 'success');
      };

      // Delete Current Map (System Menu - Superadmin)
      document.getElementById('btnDeleteCurrentMap').onclick = async () => {
        if (!currentMapId) return;
        deleteMapById(currentMapId);
        closeModal('modalSystem');
      };
    }

    // Firebase Sync Listener
    async function initFirebaseAndSync() {
      try {
        await initIndexedDB();

        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : null;
        if (firebaseConfig) {
          const app = initializeApp(firebaseConfig);
          auth = getAuth(app);
          db = getFirestore(app);

          if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
            await signInWithCustomToken(auth, __initial_auth_token);
          } else {
            await signInAnonymously(auth);
          }

          // Realtime maps listener
          onSnapshot(collection(db, 'artifacts', appId, 'public', 'data', 'maps'), (snapshot) => {
            maps = snapshot.docs.map(doc => doc.data());
            renderMapTabs();
            if (!currentMapId && maps.length > 0) selectMap(maps[0].id);
          }, (err) => console.error("Maps snapshot error:", err));

          // Realtime pins listener
          onSnapshot(collection(db, 'artifacts', appId, 'public', 'data', 'pins'), (snapshot) => {
            pins = snapshot.docs.map(doc => doc.data());
            renderPins();
          }, (err) => console.error("Pins snapshot error:", err));
        }
      } catch (err) {
        console.warn("Firebase sync fallback to local memory state:", err);
      }
    }

    // App Initialization On Load
    window.onload = () => {
      setupEventListeners();
      updateRoleUI();
      initFirebaseAndSync();
    };
  </script>
</body>
</html>
