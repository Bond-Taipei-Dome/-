    // Helper for Deleting Specific Map (Dedicated for Superadmin)
    async function deleteMapById(mapId) {
      if (currentRole !== 'SUPERADMIN') return;
      const targetMap = maps.find(m => m.id === mapId);
      if (!targetMap) return;

      if (confirm(`【權限警告：超級管理員】確定要刪除「${targetMap.name}」這張地圖及其包含的所有巡檢點位嗎？此操作無法復原！`)) {
        // 刪除該地圖對應的所有點位
        const relatedPins = pins.filter(p => p.mapId === mapId);
        for (let p of relatedPins) {
          if (db) await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'pins', p.id));
        }

        // 刪除地圖文檔與本地 IndexedDB 圖資快取
        if (db) await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'maps', mapId));
        await deleteMapFromIndexedDB(mapId);

        maps = maps.filter(m => m.id !== mapId);
        showToast(`地圖「${targetMap.name}」與附屬點位已順利刪除`, 'success');

        if (currentMapId === mapId) {
          currentMapId = maps.length > 0 ? maps[0].id : null;
          if (currentMapId) selectMap(currentMapId);
          else renderMapTabs();
        } else {
          renderMapTabs();
        }
      }
